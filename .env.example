# Global context: copy this public template to the ignored `.env`, set its mode
# to 0600 on Unix-like systems, and edit it without putting credentials in shell
# history. The runtime reads only an explicit allowlist of these settings.
# Sources:
# - https://bbc2.github.io/python-dotenv/
# - https://huggingface.co/docs/huggingface_hub/package_reference/environment_variables

# The immutable upstream identity makes downloads and reports reproducible.
MODEL_ID=Qwen/Qwen3.5-0.8B
MODEL_REVISION=2fc06364715b967f1860aea9cf38778875588b17

# These public destinations are verified before training and publication.
GITHUB_REPO_ID=BurnyCoder/training-facts-into-llms
HF_REPO_ID=BurnyCoder/qwen3.5-0.8b-atemokoloporos-lora

# A passing adapter may be published only after all acceptance checks pass.
PUBLISH_TO_HUB=true

# Put the real write-capable Hugging Face token only in `.env`. Never commit,
# print, log, pass on a command line, or place a realistic placeholder here.
HF_TOKEN=

# The fixed seed and greedy output bound make evaluation and chat reproducible.
SEED=42
MAX_NEW_TOKENS=64

# Relative paths are resolved from the repository root. Chat recursively offers
# compatible ignored checkpoint adapters rooted under ARTIFACT_DIR.
DATA_DIR=data
ARTIFACT_DIR=artifacts
# Chat logs every complete model-submitted prompt, history, rendered prompt, and
# output under ignored LOG_DIR; never enter credentials or other private data.
LOG_DIR=logs
REPORT_DIR=reports
TRACKIO_DIR=.trackio

# Trackio metrics stay local under the ignored directory above.
TRACKIO_PROJECT=training-facts-into-llms
