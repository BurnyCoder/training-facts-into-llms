# Global context: copy this public template to the ignored `.env`, keep it mode
# 0600 on Unix-like systems, and use it only for credentials and machine-local
# operational destinations. Scientific recipes live in configs/experiments/.
# Sources:
# - https://bbc2.github.io/python-dotenv/
# - https://huggingface.co/docs/huggingface_hub/package_reference/environment_variables

# A Hugging Face write token is needed only for an explicit upload. Never
# commit, print, export, source, or pass the token on a command line.
HF_TOKEN=

# Optional public namespace for archive repositories. Recipe and model identity
# remain source-pinned and cannot be redirected through `.env`.
HF_NAMESPACE=BurnyCoder

# These operational paths resolve from the repository root and must remain
# inside it. The defaults for artifacts, logs, and Trackio are Git-ignored.
# A custom destination is not automatically ignored; verify it before running.
ARTIFACT_DIR=artifacts
LOG_DIR=logs
REPORT_DIR=reports
TRACKIO_DIR=.trackio

# Trackio metrics stay local under TRACKIO_DIR.
TRACKIO_PROJECT=training-facts-into-llms
