    {
      "id": "library.peft_lora_only_serialization",
      "status": "corrected",
      "audited_claim": "Pinned PEFT explicitly includes the corresponding bias tensors when bias is lora_only; it is false that PEFT omits them from serialization.",
      "safe_wording": "This study requires bias=none to preserve its frozen-base, language-only, exact-topology contract.",
      "source_refs": [
