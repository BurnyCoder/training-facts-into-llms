      "id": "library.transformers_quantized_to",
      "status": "corrected",
      "audited_claim": "Pinned Transformers rejects a new dtype cast for bitsandbytes models but permits device-only movement for four-bit models and sufficiently recent eight-bit support.",
      "safe_wording": "The QLoRA loader skips a redundant model move because device_map already places it. Explicit dtype-changing calls are a separate restriction.",
      "source_refs": [
